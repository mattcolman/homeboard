# OpenAI key for the realtime session under test and the judge model.
OPENAI_API_KEY=your_openai_api_key

# Homeboard instance under test (the dev server).
HOMEBOARD_BASE_URL=http://localhost:3000

# Shared secret for POST /api/ingest — used by setup actions that seed widgets.
HOMEBOARD_INGEST_KEY=

# Model that judges soft expectations (default: gpt-5-mini).
# EVAL_JUDGE_MODEL=gpt-5-mini

# golf.com.au credentials for the automated login step. Never commit real values.
GOLF_USERNAME=
GOLF_PASSWORD=

# Handicap value written by the seeded-data scenario (push-ingest:golf action).
# The connect scenario captures the real value from the site instead.
# GOLF_EXPECTED_HANDICAP=17.8

# Chrome profile holding the golf.com.au session. Defaults to the spike profile
# at ../spike/browser/chrome-profile so an existing login is reused.
# GOLF_CHROME_PROFILE=/absolute/path/to/chrome-profile
