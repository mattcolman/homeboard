# Server-side only. Never expose this value in browser code.
OPENAI_API_KEY=your_openai_api_key

# 32 random bytes encoded as base64. Encrypts iCloud credentials at rest.
CALENDAR_CREDENTIAL_KEY=your_32_byte_base64_key

# Optional server-side model override for new widgets.
# HOMEBOARD_WIDGET_MODEL=gpt-5.6-luna
